# Environment Configuration for Agentic AI Data Agent
# (Optional) LLM Provider API Key - If omitted, the application runs entirely in Local Deterministic Mode
OPENAI_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini

# Database Configuration
SQLITE_DB_PATH=data/agent_data.db

# App Settings
MAX_UPLOAD_SIZE_MB=25
DEFAULT_ROW_LIMIT=100
